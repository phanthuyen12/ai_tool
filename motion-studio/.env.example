# Code-generation LLM for motion-studio. Independent from backend/.env (Flow2API/Veo3).
# Any OpenAI-compatible chat/completions endpoint works: OpenAI, Gemini-compat proxies,
# or a self-hosted/open-weight coding model (vLLM, Ollama, etc).
MOTION_LLM_BASE_URL=https://api.openai.com/v1
MOTION_LLM_API_KEY=
MOTION_LLM_MODEL=gpt-4o-mini
