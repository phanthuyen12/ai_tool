# ==============================================================================
# AI VIDEO STUDIO — Environment Configuration Template
# Copy this file to .env and fill in your credentials before production deploy.
# ==============================================================================

# --- Core Infrastructure ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=http://localhost:3000
INTERNAL_API_URL=http://127.0.0.1:8000

DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/ai_video_studio
REDIS_URL=redis://127.0.0.1:6379/0

# --- Authentication & Signed Media ---
# Generate strong random secrets in production: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
JWT_EXPIRE_MINUTES=1440
MEDIA_SIGNING_SECRET=change-this-media-signing-secret-in-production
SETTINGS_ENCRYPTION_SECRET=change-this-settings-encryption-secret-in-production

# Default bootstrap account (seeded on startup if no users exist)
ADMIN_EMAIL=admin@aivideostudio.app
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=Studio Admin

# --- Flow2API (Image & Video Generation) ---
# Documentation: https://flow.aetrading.vn/huongdan
FLOW2API_BASE_URL=https://flow.aetrading.vn/v1
FLOW2API_API_KEY=
FLOW2API_IMAGE_TIMEOUT=180
FLOW2API_VIDEO_TIMEOUT=900

# --- Script LLM Provider (OpenAI-compatible or Gemini) ---
# Providers: openai_compatible | gemini
SCRIPT_LLM_PROVIDER=openai_compatible
SCRIPT_LLM_BASE_URL=https://api.openai.com/v1
SCRIPT_LLM_API_KEY=
SCRIPT_LLM_MODEL=gpt-4o-mini

# --- Media Storage ---
# Backends: local | cloudinary | r2
STORAGE_IMAGE_BACKEND=local
STORAGE_VIDEO_BACKEND=local
LOCAL_STORAGE_DIR=./storage_local

# Cloudinary (for characters, backgrounds, generated images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ai-video-studio

# Cloudflare R2 (for generated MP4 clips, final renders, SRT, ZIP)
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ai-video-studio
R2_PUBLIC_BASE_URL=

# --- Worker & VPS Disk Safeguards ---
WORKER_VIDEO_CONCURRENCY=1
WORKER_IMAGE_CONCURRENCY=2
WORKER_REQUEST_DELAY_SECONDS=3
TEMP_WORKSPACE_DIR=/tmp/ai-video-studio
TEMP_MAX_AGE_SECONDS=7200
MIN_FREE_DISK_GB=2.0
FFMPEG_THREADS=2
FFMPEG_PRESET=veryfast
FFMPEG_CRF=23

# --- Domain / Reverse Proxy (Production Docker Compose) ---
DOMAIN_NAME=studio.example.com

